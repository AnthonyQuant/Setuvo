# Flask Core Settings
# Generate a strong secret key with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-random-secret-key
FLASK_DEBUG=True

# Local SQLite & Exports Paths (optional overrides)
SETUVO_DATABASE_PATH=database/shop.db
SETUVO_EXPORTS_DIR=exports

# Optional SMTP Email Confirmations (set MAIL_ENABLED=True when configured)
MAIL_ENABLED=False
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=orders@setuvo.ng
ADMIN_NOTIFICATION_EMAIL=admin@setuvo.ng